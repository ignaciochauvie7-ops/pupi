# Pupi AI — Environment Variables
# Copy to .env.local and fill in values

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth (NextAuth) ──
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── AI ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Email (Resend) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=hola@pupiai.com

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Pupi AI

# ── Google Maps (CRM map) ──
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ── Google Calendar / Cloud ──
GOOGLE_CLOUD_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Billing (Dodo Payments) ──
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# ── Mercado Pago ──
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ── Fiserv POS ──
FISERV_API_KEY=
FISERV_SECRET=
FISERV_WEBHOOK_SECRET=
FISERV_MERCHANT_ID=

# ── WhatsApp (Twilio) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ── Slack ──
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ── Zapier ──
ZAPIER_WEBHOOK_URL=
